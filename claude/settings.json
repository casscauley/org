{
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(npm run:*)",
      "Bash(pnpm:*)",
      "Bash(ls:*)",
      "Bash(xargs ls:*)",
      "Bash(npx:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(awk:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    }
  },
  "effortLevel": "medium",
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true
}
